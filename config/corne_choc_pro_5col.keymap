#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/rgb.h>

// Local import of custom keybinds
#include "includes/keymaps.dtsi"

#define BASE 0
#define SYMBOLS 1
#define MEDIA 2
#define CONNECTIVITY 3

&mt {
    flavor = "tap-preferred";
    tapping-term-ms = <200>;
};

/ {
    chosen {
        zmk,physical-layout = &five_col_layout;
    };

    keymap {
        compatible = "zmk,keymap";
        base_layer {
            display-name = "BASE";
            bindings = <
                &kp Q        &kp W        &kp E        &kp R       &kp T &kp C_MUTE &kp C_PP &kp Y     &kp U       &kp I       &kp O        &kp P
                &mt LSHFT A  &mt LCTRL S  &mt LALT D   &mt LGUI F  &kp G &kp LALT   &kp RALT &kp H     &mt RGUI J  &mt RALT K  &mt RCTRL L  &mt RSHIFT SQT
                &kp Z        &kp X        &kp C        &kp V       &kp B                     &kp N     &kp M       &kp COMMA   &kp DOT      &kp MINUS
                                          &mo SYMBOLS  &kp SPACE   &lt MEDIA ESC             &kp BSPC  &kp RET     &mo SYMBOLS
            >;
        };

        symbols_layer {
            display-name = "SYMBOLS";
            bindings = <
                &none      &none      &none       &none       &none &trans   &trans   &none    &none      &none       &none       &none
                &kp LGUI   &kp LALT   &kp LCTRL   &kp LSHFT   &none &kp LALT &kp RALT &kp CAPS &kp LEFT   &kp DOWN    &kp UP      &kp RIGHT
                &none      &none      &none       &none       &none                   &kp INS  &kp HOME   &kp PG_DN   &kp PG_UP   &kp END
                                                &trans &trans &trans                  &trans &trans &trans
            >;
        };

        media_layer {
            display-name = "MEDIA";
            bindings = <
  &trans  &kp C_PREV  &kp UP    &kp C_NEXT  &kp C_VOL_UP  &trans  &trans  &trans  &kp N7  &kp N8  &kp N9  &trans
  &trans  &kp LEFT    &kp DOWN  &kp RIGHT   &kp C_VOL_DN  &trans  &trans  &trans  &kp N4  &kp N5  &kp N6  &trans
  &trans  &trans      &kp C_PP  &trans      &kp C_MUTE                    &trans  &kp N1  &kp N2  &kp N3  &kp N0
                      &trans    &trans      &trans                        &trans  &trans  &trans
            >;
        };

        conn_layer {
            display-name = "CONNECTIVITY";
            bindings = <
                &kp LBKT   &kp N7   &kp N8    &kp N9   &kp RBKT  &trans &trans &none &none      &none      &none     &none
                &kp SEMI   &kp N4   &kp N5    &kp N6   &kp EQUAL &trans &trans &none &kp RSHFT  &kp RCTRL  &kp RALT  &kp RGUI
                &kp GRAVE  &kp N1   &kp N2    &kp N3   &kp BSLH                &none &none      &none      &none     &none
                                           &kp DOT &kp N0 &kp MINUS            &trans &trans &trans
            >;
        };
    };
};

/*             hold-trigger-on-release; */
/*         }; */
/**/
/*         mt: home_row_mod_right { */
/*             compatible = "zmk,behavior-hold-tap"; */
/*             #binding-cells = <2>; */
/*             flavor = "balanced"; */
/*             require-prior-idle-ms = <120>; */
/*             tapping-term-ms = <200>; */
/*             quick-tap-ms = <150>; */
/*             bindings = <&kp>, <&kp>; */
/*             hold-trigger-on-release; */
/*         }; */
/*     }; */
/* }; */

/ {
    chosen {
        zmk,physical-layout = &five_col_layout;
    };

    keymap {
        compatible = "zmk,keymap";
        base_layer {
            display-name = "BASE";
            bindings = <
  &kp Q         &kp W        &kp E         &kp R       &kp T  &kp C_MUTE        &kp C_PP  &kp Y          &kp U       &kp I        &kp O       &kp P
  &mt LSHIFT A  &mt LCTRL S  &mt LALT D    &mt LGUI F  &kp G  &mo CONNECTIVITY  &trans    &kp H          &mt LGUI J  &mt LCTRL K  &mt LALT L  &mt RSHIFT SQT
  &kp Z         &kp X        &kp C         &kp V       &kp B                              &kp N          &kp M       &kp COMMA    &kp DOT     &kp MINUS
                             &mo SYMBOLS   &kp SPACE   &lt MEDIA ESCAPE                   &kp BACKSPACE  &kp RET     &mo SYMBOLS
            >;
        };

        symbol_layer {
            display-name = "SYMBOLS";
            bindings = <
  &trans  &kp EXCL  &kp L_COLON   &kp L_EQUAL   &kp PLUS   &trans  &trans  &kp BSLH  &kp L_LCURLY  &kp L_RCURLY  &trans    &trans
  &trans  &kp DQT   &kp L_BCKTCK  &kp L_CARET   &kp TILDE  &trans  &trans  &kp L_LT  &kp L_LSQBKT  &kp L_RSQBKT  &kp L_GT  &trans
  &trans  &kp L_LT  &kp L_AMPS    &kp L_DOLLAR  &trans                     &trans    &kp L_LBRKT   &kp L_RBRKT   &trans    &trans
                    &trans        &trans        &trans                     &trans    &trans        &kp TAB
            >;
        };

        media_layer {
            display-name = "MEDIA";
            bindings = <
  &trans  &kp C_PREV  &kp UP    &kp C_NEXT  &kp C_VOL_UP  &trans  &trans  &trans  &kp N7  &kp N8  &kp N9  &trans
  &trans  &kp LEFT    &kp DOWN  &kp RIGHT   &kp C_VOL_DN  &trans  &trans  &trans  &kp N4  &kp N5  &kp N6  &trans
  &trans  &trans      &kp C_PP  &trans      &kp C_MUTE                    &trans  &kp N1  &kp N2  &kp N3  &kp N0
                      &trans    &trans      &trans                        &trans  &trans  &trans
            >;
        };

        conn_layer {
            display-name = "CONNECTIVITY";
            bindings = <
  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans        &trans        &trans        &trans
  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &bt BT_SEL 1  &bt BT_SEL 2  &bt BT_SEL 3  &trans
  &trans  &trans  &trans  &trans  &trans                  &trans  &bt BT_NXT    &bt BT_PRV    &trans        &trans
                  &trans  &trans  &trans                  &trans  &trans        &trans
            >;
        };

